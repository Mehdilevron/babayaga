# Copy this file to .env and fill in real values. NEVER commit .env.
# Use a dedicated "hot" wallet funded only with what you're willing to risk -
# this bot signs and submits transactions with no human approval step.

# ---- EVM (Ethereum / Polygon / Arbitrum) ----
EVM_PRIVATE_KEY=0xyour_private_key_here
ETHEREUM_RPC_URL=https://eth-mainnet.g.alchemy.com/v2/your_key
POLYGON_RPC_URL=https://polygon-mainnet.g.alchemy.com/v2/your_key
ARBITRUM_RPC_URL=https://arb-mainnet.g.alchemy.com/v2/your_key

# ---- Solana ----
SOLANA_PRIVATE_KEY=your_base58_or_json_array_secret_key
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# ---- MetaTrader 5 (hedge leg) ----
# Requires the MetaTrader5 Python package + a running, logged-in MT5 terminal
# on the SAME machine (Windows, or Wine). Cannot run inside a plain Linux
# container with no terminal installed.
MT5_LOGIN=12345678
MT5_PASSWORD=your_mt5_password
MT5_SERVER=YourBroker-Server
MT5_TERMINAL_PATH=C:\Program Files\MetaTrader 5\terminal64.exe

# ---- Safety ----
# "true" = simulate only, no orders sent anywhere. Must be explicitly set to
# "false" to allow live execution, on top of config.yaml's dry_run setting.
DRY_RUN=true
